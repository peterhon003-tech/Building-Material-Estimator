# 複製成 .env 後修改。不要把 .env 放入 Git。

# 用一串長而隨機的字（可用：python -c "import secrets;print(secrets.token_urlsafe(50))"）
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
# 同事用來打開網站的主機名稱或 IP，用逗號分隔
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.50,fireboard.company.local
# 同上，但要包括 http:// 和埠號
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://192.168.1.50:8000,http://fireboard.company.local:8000

POSTGRES_DB=fireboard
POSTGRES_USER=fireboard
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# 網站對外的埠號
WEB_PORT=8000
