# ============================================================
#  Fire Board Estimator - HTTPS (Caddy)
#
#  Caddy sits in front of the website and encrypts the connection.
#  - Same port as before (WEB_PORT, default 8000), but https://
#    e.g. https://192.168.0.98:8000
#  - If someone types http://, Caddy sends them to https:// automatically
#  - The certificate comes from Caddy's own private CA ("internal").
#    Install its root certificate on each PC once, so the browser trusts it
#    (see README_https.txt).
#  - FB_SERVER_NAME (in .env) = the address colleagues type, e.g. 192.168.0.98
# ============================================================
{
	admin off
	local_certs
	skip_install_trust
	auto_https disable_redirects
	# Browsers do not send a name when you type an IP address; use this one
	default_sni {$FB_SERVER_NAME:127.0.0.1}
	servers :443 {
		listener_wrappers {
			http_redirect
			tls
		}
		# Who may pass on the colleague's real IP (X-Forwarded-For).
		# Default: nobody (192.0.2.1 is a documentation address that never connects).
		# Only after step 5 (Windows Caddy, WEB_PORT=127.0.0.1:8443) set in .env:
		#   FB_TRUSTED_PROXIES=private_ranges
		trusted_proxies static {$FB_TRUSTED_PROXIES:192.0.2.1/32}
	}
}

localhost, {$FB_SERVER_NAME:127.0.0.1} {
	encode gzip
	header -Server
	reverse_proxy web:8000
}
